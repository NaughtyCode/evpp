// X-macro list of all MongoDB binding types.
// Each entry registers a metatable and adds its function library to a module.
//
// Format: MONGOC_TYPE(module, CppName)
//   module  — "bson" or "mongoc" (which Lua module to export into)
//   CppName — the CamelCase type name (used to derive Register*Meta / Get*Lib / header)
//
// Adding a new type requires ONLY adding one line here.
// The old 3-point registration (include + RegisterMeta + AddToModule) is gone.

#ifndef MONGOC_TYPE
#error "MONGOC_TYPE must be defined before including mongo_types.def"
#endif

// ── bson module ──────────────────────────────────────────────────────
MONGOC_TYPE(bson, BsonDocument)
MONGOC_TYPE(bson, BsonIter)
MONGOC_TYPE(bson, BsonArrayBuilder)
MONGOC_TYPE(bson, BsonContext)
MONGOC_TYPE(bson, BsonString)
MONGOC_TYPE(bson, BsonJsonReader)
MONGOC_TYPE(bson, BsonJsonDataReader)
MONGOC_TYPE(bson, BsonReader)
MONGOC_TYPE(bson, BsonWriter)
MONGOC_TYPE(bson, BsonJsonOpts)
MONGOC_TYPE(bson, BsonValue)
MONGOC_TYPE(bson, BsonVectorInt8ConstView)
MONGOC_TYPE(bson, BsonVectorInt8View)
MONGOC_TYPE(bson, BsonVectorFloat32ConstView)
MONGOC_TYPE(bson, BsonVectorFloat32View)
MONGOC_TYPE(bson, BsonVectorPackedBitConstView)
MONGOC_TYPE(bson, BsonVectorPackedBitView)

