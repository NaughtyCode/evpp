{
  "resource_dir": "resources",
  "log": {
    "dir": "logs",
    "level": "info",
    "rotation_size_mb": 100,
    "max_backup_files": 10,
    "format_pattern": "%(time) [%(thread_name):%(thread_id)] [%(log_level_short_code)] [%(short_source_location)] [%(caller_function)] [%(logger)] %(message)"
  },
  "frame": {
    "target_fps": 30,
    "interval_ms": 33,
    "slow_threshold_multiplier": 2
  },
  "hot_reload": {
    "enabled": true,
    "startup_delay_ms": 60000,
    "poll_interval_ms": 1000,
    "debounce_ms": 300
  },
  "scripts_dir": "resources/script/runtime",
  "sandbox_level": "strict"
}
